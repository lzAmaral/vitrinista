# Banco local (SQLite via libsql). Em produção pode virar uma URL libsql://... (Turso)
DATABASE_URL=file:local.db

# Coleta do Instagram: "exemplo" (dados fictícios para desenvolver) ou "meta" (Graph API oficial)
COLETOR=exemplo

# Meta Graph API — Business Discovery (preencher depois de criar o app na Meta)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v27.0

# Gemini (fase 2 — análise e estúdio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Só para o script "npm run meta:configurar" (Configurações do app na Meta → Básico)
META_APP_ID=
META_APP_SECRET=
